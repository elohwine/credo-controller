{
  "appId": "com.credentis.mobile",
  "appName": "Credentis",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "*.credentis.app",
      "*.credentis.co.zw",
      "*.ngrok-free.app",
      "*.ngrok-free.dev",
      "*.ngrok.io",
      "localhost",
      "172.28.145.215"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#2188ca",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK"
    }
  }
}
